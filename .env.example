# PostgreSQL (Easypanel internal network)
DATABASE_URL=postgresql://mcdaapp:change-me@ams_mcda-nextjs-v2-db:5432/mcda_nextjs_v2

# Generate a long random secret. Do not commit the real value.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public application URL. Required for Google OAuth callback URL.
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# Google OAuth Web Application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=mail.micro-support.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@micro-support.com
SMTP_PASSWORD=
SMTP_FROM=MCDA Decision Analysis <noreply@micro-support.com>

# AMS Payment Gateway
# API key is server-side only. Never expose it through NEXT_PUBLIC_* variables.
AMS_GATEWAY_BASE_URL=https://ams-gateway.micro-support.com
AMS_GATEWAY_API_KEY=
AMS_SERVICE_CODE=

# AMS Hosted Checkout: MCDA never receives or stores Stripe keys.
# Flow: MCDA -> AMS -> Stripe Checkout; Stripe -> AMS webhook -> MCDA relay webhook.
# Configure this service's default client webhook in AMS as:
#   https://<mcda-domain>/api/webhooks/ams
AMS_STRIPE_PAYMENT_METHODS=card,promptpay

# Comma-separated accounts allowed to change membership duration in /billing.
MCDA_ADMIN_EMAILS=

# Temporary payment troubleshooting logs for Easypanel stdout.
# Logs request metadata and the AMS JSON response, but never logs the API key or image bytes.
# Disable again after troubleshooting in production.
MCDA_PAYMENT_DEBUG_LOG=false

# Legacy/common Premium price fallback. Defaults to 59.00 THB when omitted.
MCDA_PREMIUM_WEEKLY_PRICE_THB=59.00
# Optional independent overrides; blank means use the common fallback above.
# EASYSLIP: direct PromptPay QR + uploaded slip, verified via AMS/EasySlip.
# STRIPE: BOTH card and PromptPay on AMS Hosted Checkout / Stripe.
# Positive THB amounts, maximum 2 decimal places. Do not use NEXT_PUBLIC_*.
MCDA_PREMIUM_WEEKLY_PRICE_THB_EASYSLIP=
MCDA_PREMIUM_WEEKLY_PRICE_THB_STRIPE=
# Restart/redeploy the MCDA service after changing its Environment settings.
# Existing order amounts remain unchanged; only new orders use updated prices.
# Duration remains shared, stored in PostgreSQL, and editable from /billing.

# Standard Thai PromptPay receiver (server-side only).
# Preferred configuration:
#   phone       -> 10-digit Thai mobile number, e.g. 0836777796
#   national_id -> 13-digit National ID / Tax ID, digits only
MCDA_PROMPTPAY_TYPE=phone
MCDA_PROMPTPAY_ID=

# Optional but recommended: require the receiver name returned by EasySlip/AMS
# to match the configured merchant name as well as the PromptPay proxy.
MCDA_PAYMENT_RECEIVER_NAME_TH=
MCDA_PAYMENT_RECEIVER_NAME_EN=

# Backward-compatible optional fallbacks. Normally leave these blank when using
# MCDA_PROMPTPAY_TYPE + MCDA_PROMPTPAY_ID above.
MCDA_PROMPTPAY_PHONE=
MCDA_PROMPTPAY_NATIONAL_ID=

# Application-managed Premium trial: no card and no automatic billing.
# Enable explicitly after rollout; starts when a verified Free member claims it.
# Trial can be claimed once per account. Existing claims keep their stored expiry.
MCDA_TRIAL_ENABLED=false
MCDA_TRIAL_DAYS=7
# Admin creates codes at /admin/redeem-codes; members redeem at /billing.
# Disabling new redemptions never removes already-granted Premium time.
MCDA_REDEEM_ENABLED=true
# See docs/TRIAL_AND_REDEEM.md. Restart/redeploy after changing these values.

# MCDA Advisor chatbot (server-side only)
# Vercel AI Gateway is the default provider used by the AI SDK.
AI_GATEWAY_API_KEY=
# Optional override. Default: openai/gpt-5.6-luna
MCDA_ADVISOR_MODEL=openai/gpt-5.6-luna

# Preferred production path: AI structuring/retrieval runs on Vercel with OIDC.
MCDA_ADVISOR_SERVICE_URL=https://mcda-advisor-service.vercel.app
# Optional. If blank, the app reuses AMS_SERVICE_CODE as the server-to-server credential.
MCDA_ADVISOR_SERVICE_SECRET=

# The chatbot UI is visible after deployment; configure AI_GATEWAY_API_KEY to enable live AI responses.

# Local fallback when the cloud advisor service is unavailable.
# Easypanel internal service; do not expose Ollama publicly.
MCDA_LOCAL_LLM_URL=http://ams_mcda-advisor-ollama:11434
MCDA_LOCAL_LLM_MODEL=qwen3:4b
