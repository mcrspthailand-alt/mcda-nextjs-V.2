# PostgreSQL (Easypanel internal network)
DATABASE_URL=postgresql://mcdaapp:change-me@ams_mcda-nextjs-v2-db:5432/mcda_nextjs_v2

# Generate a long random secret. Do not commit the real value.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public application URL. Required for Google OAuth callback URL.
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# Google OAuth Web Application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=mail.micro-support.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@micro-support.com
SMTP_PASSWORD=
SMTP_FROM=MCDA Decision Analysis <noreply@micro-support.com>

# AMS Payment Gateway
# API key is server-side only. Never expose it through NEXT_PUBLIC_* variables.
AMS_GATEWAY_BASE_URL=https://ams-gateway.micro-support.com
AMS_GATEWAY_API_KEY=
AMS_SERVICE_CODE=

# Standard Thai PromptPay receiver (server-side only).
# Preferred configuration:
#   phone       -> 10-digit Thai mobile number, e.g. 0836777796
#   national_id -> 13-digit National ID / Tax ID, digits only
MCDA_PROMPTPAY_TYPE=phone
MCDA_PROMPTPAY_ID=

# Backward-compatible optional fallbacks. Normally leave these blank when using
# MCDA_PROMPTPAY_TYPE + MCDA_PROMPTPAY_ID above.
MCDA_PROMPTPAY_PHONE=
MCDA_PROMPTPAY_NATIONAL_ID=
